   "index": "a0096",
   "roundness": null,
   "seed": 1334145666,
   "version": 1,
   "versionNonce": 754135363,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1790000000000,
   "link": null,
   "locked": false,
   "text": "prediction = sum( sim_i x confidence_i ) / sum( sim_i )\nover the top K.\nMinimum-similarity threshold: if all neighbours are below\nit -> 'no precedent', no forced answer.\nEvaluate on held-out matches like xG models: Brier score,\nAUC, calibration (reliability diagram).",
   "originalText": "prediction = sum( sim_i x confidence_i ) / sum( sim_i )\nover the top K.\nMinimum-similarity threshold: if all neighbours are below\nit -> 'no precedent', no forced answer.\nEvaluate on held-out matches like xG models: Brier score,\nAUC, calibration (reliability diagram).",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
