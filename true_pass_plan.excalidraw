  {
   "id": "_Ha6ili8GjHEAD6-Wj9Kf",
   "type": "text",
   "x": 470,
   "y": 1995,
   "width": 720,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
