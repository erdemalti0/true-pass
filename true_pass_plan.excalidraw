  {
   "id": "e28_ajY75FnCttn6kfaqD",
   "type": "text",
   "x": 470,
   "y": 2715,
   "width": 720,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0030",
   "roundness": null,
   "seed": 161455264,
   "version": 1,
   "versionNonce": 1304734861,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1790000000000,
   "link": null,
   "locked": false,
   "text": "Between consecutive 360 frames, match the points of the\nsame team with the Hungarian algorithm (cost = distance).\nReject any pair that needs more than v_hard x dt of\nmovement (physically impossible).\nUnmatched points = player left / entered the camera view.\nIdentity anchors: receiver is labelled in frames where he\nis the actor (his Ball Receipt / Carry events); defenders\nare labelled in their own defensive events.\nGoal is continuity, not full identity.",
   "originalText": "Between consecutive 360 frames, match the points of the\nsame team with the Hungarian algorithm (cost = distance).\nReject any pair that needs more than v_hard x dt of\nmovement (physically impossible).\nUnmatched points = player left / entered the camera view.\nIdentity anchors: receiver is labelled in frames where he\nis the actor (his Ball Receipt / Carry events); defenders\nare labelled in their own defensive events.\nGoal is continuity, not full identity.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
