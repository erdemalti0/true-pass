   "updated": 1790000000000,
   "link": null,
   "locked": false,
   "text": "metric score = weighted sum of metrics 1-4 (equal weights\nto start), adjusted by metric 5. Independent of the\nattack's outcome.\nMissing-data multiplier: lower confidence when the share\nof predicted (heat area / fallback) players vs seen\nplayers is high, e.g. mid-pitch passes where players\ncannot be found or predicted.\nTrue-pass threshold: to be tuned.",
   "originalText": "metric score = weighted sum of metrics 1-4 (equal weights\nto start), adjusted by metric 5. Independent of the\nattack's outcome.\nMissing-data multiplier: lower confidence when the share\nof predicted (heat area / fallback) players vs seen\nplayers is high, e.g. mid-pitch passes where players\ncannot be found or predicted.\nTrue-pass threshold: to be tuned.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
