   "link": null,
   "locked": false,
   "text": "Metrics (each normalized to 0 - 1)",
   "originalText": "Metrics (each normalized to 0 - 1)",
   "fontSize": 24,
   "fontFamily": 8,
   "textAlign": "center",
   "verticalAlign": "top",
