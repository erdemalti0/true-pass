  {
   "id": "WxaLYUoQXQZip2SFXy7KS",
   "type": "text",
   "x": 470,
   "y": 9275,
   "width": 720,
   "height": 525.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
