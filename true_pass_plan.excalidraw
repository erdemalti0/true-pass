  },
  {
   "id": "hT61qtc4xatws8phP9nhF",
   "type": "text",
   "x": 470,
   "y": 945,
   "width": 720,
   "height": 350.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0012",
   "roundness": null,
   "seed": 821653593,
   "version": 1,
   "versionNonce": 1189349777,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1790000000000,
   "link": null,
   "locked": false,
   "text": "Attack = one StatsBomb possession (possession field) that\nends with a shot.\nExclude: own goals, cancelled goals, penalty shots.\nSet-piece origin attacks are kept but flagged with\nplay_pattern.\nExclude attacks with 0 or 1 completed passes by the\nattacking team inside the possession (no chain,\nspontaneous).\nStore the rest as legit shots.\nKeep the shot's statsbomb_xg (used for the xG bonus in\nphase 3).\nAlso collect possessions that do NOT end with a shot as a\nCONTROL GROUP (not negatives - a pass can be good even if\nno shot follows).",
   "originalText": "Attack = one StatsBomb possession (possession field) that\nends with a shot.\nExclude: own goals, cancelled goals, penalty shots.\nSet-piece origin attacks are kept but flagged with\nplay_pattern.\nExclude attacks with 0 or 1 completed passes by the\nattacking team inside the possession (no chain,\nspontaneous).\nStore the rest as legit shots.\nKeep the shot's statsbomb_xg (used for the xG bonus in\nphase 3).\nAlso collect possessions that do NOT end with a shot as a\nCONTROL GROUP (not negatives - a pass can be good even if\nno shot follows).",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
