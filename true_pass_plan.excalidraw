  {
   "id": "5biDm0VZty1_Z4RlvUOUj",
   "type": "text",
   "x": 470,
   "y": 8860,
   "width": 720,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
